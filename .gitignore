# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# App Store Connect CLI credentials and retry reports
/.asc/config.json
/.asc/reports/

# Multi-agent coordination board (machine-local, see AGENTS.md)
.coord/

# typescript
*.tsbuildinfo

app-example

# generated native folders
/ios
/android
scripts/test/build/

# Local build products and simulator/test captures
/artifacts/
/builds/
/modules/*/android/build/

# The Worker has its own toolchain (Workers runtime types, not React Native).
server/node_modules/
server/.wrangler/
server/.test-build/

# Transient git worktrees created by parallel agent runs. The checkouts are
# scratch space for a single run and are removed when it ends; the work itself
# arrives as branches, never as files here.
.claude/worktrees/
.variate/
