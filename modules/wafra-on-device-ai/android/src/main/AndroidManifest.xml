<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
  <!--
    ML Kit GenAI declares minSdk 26. Wafra supports API 24, so the merge is
    overridden here and WafraOnDeviceAIModule reports `unsupported-os` without
    loading any ML Kit class below API 26.
  -->
  <uses-sdk tools:overrideLibrary="com.google.mlkit.genai.prompt, com.google.mlkit.genai.common" />
  <!-- Normal (install-time) permission: getNetworkType reads whether the
       active connection is unmetered Wi-Fi for "Wi-Fi only" model downloads. -->
  <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
</manifest>
