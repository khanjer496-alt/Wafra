<?xml version="1.0" encoding="utf-8"?>
<!-- Live "Today" widget on Home's ink band. An exact seven-day total at the
     top; the one figure that matters sits low on the band. Every value is set
     from the snapshot at render time; the XML text is only the empty state
     shown before the first render. Below 152dp of height the week (its bars,
     pattern corner and total) is left out (WafraWidgets.TODAY_FULL_MIN_HEIGHT_DP).
     The bars and the budget bar are white masks drawn in code
     (WidgetGraphics) and tinted here, so their colours follow night mode.

     The outer frame is the widget background: Android 12+ rounds it to the
     launcher's own widget radius (drawable-v31) and clips content to it. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@android:id/background"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@drawable/wafra_widget_today_background"
  android:clipToOutline="true">

  <LinearLayout
    android:id="@+id/wafra_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
      android:id="@+id/wafra_today_week"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="vertical"
      android:visibility="gone">

      <!-- "Last 7 days" with, in the corner, three of the pattern's shapes. -->
      <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView
          android:id="@+id/wafra_today_week_label"
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:ellipsize="end"
          android:maxLines="1"
          android:text="@string/wafra_widget_last_7_total"
          android:textAlignment="viewStart"
          android:textColor="@color/wafra_widget_today_secondary"
          android:textSize="12sp" />
        <ImageView
          android:id="@+id/wafra_today_pattern"
          android:layout_width="34dp"
          android:layout_height="14dp"
          android:layout_marginStart="8dp"
          android:importantForAccessibility="no"
          android:src="@drawable/wafra_widget_pattern_today" />
      </LinearLayout>

      <!-- Seven bars (today in the accent, a zero day a thin baseline) and
           their total in whole units, which never breaks. -->
      <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="bottom"
        android:orientation="horizontal">
        <FrameLayout
          android:layout_width="0dp"
          android:layout_height="24dp"
          android:layout_weight="1"
          android:importantForAccessibility="noHideDescendants">
          <ImageView
            android:id="@+id/wafra_today_bars"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|start"
            android:importantForAccessibility="no"
            android:tint="@color/wafra_widget_today_mark" />
          <ImageView
            android:id="@+id/wafra_today_bars_today"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|start"
            android:importantForAccessibility="no"
            android:tint="@color/wafra_widget_today_accent" />
        </FrameLayout>
        <TextView
          android:id="@+id/wafra_today_week_amount"
          android:layout_width="wrap_content"
          android:layout_height="18dp"
          android:layout_marginStart="8dp"
          android:fontFamily="sans-serif-medium"
          android:fontFeatureSettings="tnum"
          android:gravity="center_vertical"
          android:maxLines="1"
          android:textDirection="firstStrongLtr"
          android:textColor="@color/wafra_widget_today_text"
          android:textSize="13sp" />
      </LinearLayout>
    </LinearLayout>

    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="0dp"
      android:layout_weight="1"
      android:gravity="bottom"
      android:orientation="vertical">

      <TextView
        android:id="@+id/wafra_today_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="@string/wafra_widget_today"
        android:textAlignment="viewStart"
        android:textColor="@color/wafra_widget_today_secondary"
        android:textSize="12sp" />

      <TextView
        android:id="@+id/wafra_today_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:fontFamily="sans-serif-medium"
        android:text="@string/wafra_widget_open_to_update"
        android:textAlignment="viewStart"
        android:textColor="@color/wafra_widget_today_text"
        android:textSize="15sp" />

      <LinearLayout
        android:id="@+id/wafra_today_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- The band figure: semibold sans with tabular digits (never a
             monospaced face). The currency code is set smaller and dimmed in
             code. It shrinks to fit rather than cutting a number short. -->
        <TextView
          android:id="@+id/wafra_today_amount"
          android:layout_width="match_parent"
          android:layout_height="38dp"
          android:autoSizeMaxTextSize="30sp"
          android:autoSizeMinTextSize="11sp"
          android:autoSizeTextType="uniform"
          android:fontFamily="sans-serif-medium"
          android:fontFeatureSettings="tnum"
          android:gravity="center_vertical|start"
          android:letterSpacing="-0.02"
          android:maxLines="1"
          android:textAlignment="viewStart"
          android:textColor="@color/wafra_widget_today_text"
          android:textSize="28sp" />

        <!-- How much of the budgets is used: accent, or the over colour once
             a budget is past its limit. -->
        <FrameLayout
          android:id="@+id/wafra_today_progress"
          android:layout_width="match_parent"
          android:layout_height="4dp"
          android:layout_marginTop="2dp"
          android:layout_marginBottom="4dp"
          android:background="@drawable/wafra_widget_progress_track"
          android:importantForAccessibility="noHideDescendants"
          android:visibility="gone">
          <ImageView
            android:id="@+id/wafra_today_progress_fill"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:scaleType="fitXY"
            android:tint="@color/wafra_widget_today_accent" />
          <ImageView
            android:id="@+id/wafra_today_progress_over"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:scaleType="fitXY"
            android:tint="@color/wafra_widget_today_over"
            android:visibility="gone" />
        </FrameLayout>

        <TextView
          android:id="@+id/wafra_today_count"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:maxLines="1"
          android:ellipsize="end"
          android:textAlignment="viewStart"
          android:textColor="@color/wafra_widget_today_secondary"
          android:textSize="12sp" />

        <!-- Left in (or over) budgets, as on iOS: the amount is its own view
             and never breaks; the words beside it wrap or shorten instead.
             The row hugs its content from the start edge, so the words sit
             next to the amount in both reading directions. Arabic puts the
             words first (lead), English after the amount (trail). -->
        <LinearLayout
          android:id="@+id/wafra_today_budget"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_gravity="start"
          android:orientation="horizontal"
          android:visibility="gone">

          <TextView
            android:id="@+id/wafra_today_budget_lead"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="2"
            android:textAlignment="viewStart"
            android:textColor="@color/wafra_widget_today_secondary"
            android:textSize="12sp"
            android:visibility="gone" />

          <TextView
            android:id="@+id/wafra_today_budget_amount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFeatureSettings="tnum"
            android:maxLines="1"
            android:textColor="@color/wafra_widget_today_secondary"
            android:textSize="12sp" />

          <TextView
            android:id="@+id/wafra_today_budget_trail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="2"
            android:textAlignment="viewStart"
            android:textColor="@color/wafra_widget_today_secondary"
            android:textSize="12sp"
            android:visibility="gone" />
        </LinearLayout>
      </LinearLayout>
    </LinearLayout>
  </LinearLayout>
</FrameLayout>
