<?xml version="1.0" encoding="utf-8"?>
<!-- Live "Coming up" widget: up to three bills from the snapshot. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/wafra_widget_root"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@drawable/wafra_widget_background"
  android:orientation="vertical"
  android:padding="16dp">

  <TextView
    android:id="@+id/wafra_upcoming_label"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:maxLines="1"
    android:ellipsize="end"
    android:text="@string/wafra_widget_upcoming"
    android:textAlignment="viewStart"
    android:textColor="@color/wafra_widget_secondary"
    android:textSize="13sp"
    android:textStyle="bold" />

  <TextView
    android:id="@+id/wafra_upcoming_empty"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:text="@string/wafra_widget_open_to_update"
    android:textAlignment="viewStart"
    android:textColor="@color/wafra_widget_text"
    android:textSize="15sp" />

  <LinearLayout
    android:id="@+id/wafra_bill_row_1"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="4dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:visibility="gone">

    <LinearLayout
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:orientation="vertical">

      <TextView
        android:id="@+id/wafra_bill_title_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:ellipsize="end"
        android:textAlignment="viewStart"
        android:textColor="@color/wafra_widget_text"
        android:textSize="14sp" />

      <TextView
        android:id="@+id/wafra_bill_date_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:ellipsize="end"
        android:textAlignment="viewStart"
        android:textColor="@color/wafra_widget_secondary"
        android:textSize="12sp" />
    </LinearLayout>

    <TextView
      android:id="@+id/wafra_bill_amount_1"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginStart="12dp"
      android:maxLines="1"
      android:textColor="@color/wafra_widget_text"
      android:textSize="14sp"
      android:textStyle="bold" />
  </LinearLayout>

  <LinearLayout
    android:id="@+id/wafra_bill_row_2"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="6dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:visibility="gone">

    <LinearLayout
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:orientation="vertical">

      <TextView
        android:id="@+id/wafra_bill_title_2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:ellipsize="end"
        android:textAlignment="viewStart"
        android:textColor="@color/wafra_widget_text"
        android:textSize="14sp" />

      <TextView
        android:id="@+id/wafra_bill_date_2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:ellipsize="end"
        android:textAlignment="viewStart"
        android:textColor="@color/wafra_widget_secondary"
        android:textSize="12sp" />
    </LinearLayout>

    <TextView
      android:id="@+id/wafra_bill_amount_2"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginStart="12dp"
      android:maxLines="1"
      android:textColor="@color/wafra_widget_text"
      android:textSize="14sp"
      android:textStyle="bold" />
  </LinearLayout>

  <LinearLayout
    android:id="@+id/wafra_bill_row_3"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="6dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:visibility="gone">

    <LinearLayout
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:orientation="vertical">

      <TextView
        android:id="@+id/wafra_bill_title_3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:ellipsize="end"
        android:textAlignment="viewStart"
        android:textColor="@color/wafra_widget_text"
        android:textSize="14sp" />

      <TextView
        android:id="@+id/wafra_bill_date_3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:ellipsize="end"
        android:textAlignment="viewStart"
        android:textColor="@color/wafra_widget_secondary"
        android:textSize="12sp" />
    </LinearLayout>

    <TextView
      android:id="@+id/wafra_bill_amount_3"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginStart="12dp"
      android:maxLines="1"
      android:textColor="@color/wafra_widget_text"
      android:textSize="14sp"
      android:textStyle="bold" />
  </LinearLayout>
</LinearLayout>
