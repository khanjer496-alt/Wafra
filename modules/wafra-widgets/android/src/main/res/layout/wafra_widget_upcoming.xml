<?xml version="1.0" encoding="utf-8"?>
<!-- Live "Coming up" widget on Bills' ochre band: up to three bills from the
     snapshot, each with its bundled merchant logo (initial fallback),
     due pill and amount, under a header with their total. Short widgets list fewer rows instead of clipping:
     three from 170dp of height, two from 130dp, otherwise one
     (WafraWidgets.upcomingRowsFor).

     The outer frame is the widget background: Android 12+ rounds it to the
     launcher's own widget radius (drawable-v31) and clips content to it.
     Titles and amounts take their direction from their first strong letter,
     falling back to left-to-right, so a masked card ("•••• 1234") and
     "≈ AED 380.00" keep their order inside Arabic. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@android:id/background"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@drawable/wafra_widget_upcoming_background"
  android:clipToOutline="true">

  <LinearLayout
    android:id="@+id/wafra_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- "Coming up" and what the listed bills add up to. -->
    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:gravity="center_vertical"
      android:orientation="horizontal">
      <TextView
        android:id="@+id/wafra_upcoming_label"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:fontFamily="sans-serif-medium"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="@string/wafra_widget_upcoming"
        android:textAlignment="viewStart"
        android:textColor="@color/wafra_widget_upcoming_text"
        android:textSize="12sp" />
      <TextView
        android:id="@+id/wafra_upcoming_total"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:fontFamily="sans-serif-medium"
        android:fontFeatureSettings="tnum"
        android:maxLines="1"
        android:textDirection="firstStrongLtr"
        android:textColor="@color/wafra_widget_upcoming_text"
        android:textSize="12sp"
        android:visibility="gone" />
    </LinearLayout>

    <!-- Empty and stale states sit centred in the space under the header;
         a clear month also shows the calendar glyph. -->
    <LinearLayout
      android:id="@+id/wafra_upcoming_empty_block"
      android:layout_width="match_parent"
      android:layout_height="0dp"
      android:layout_weight="1"
      android:gravity="center"
      android:orientation="vertical">
      <ImageView
        android:id="@+id/wafra_upcoming_empty_glyph"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginBottom="6dp"
        android:importantForAccessibility="no"
        android:src="@drawable/wafra_widget_glyph_calendar"
        android:visibility="gone" />
      <TextView
        android:id="@+id/wafra_upcoming_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:text="@string/wafra_widget_open_to_update"
        android:textAlignment="center"
        android:textColor="@color/wafra_widget_upcoming_text"
        android:textSize="14sp" />
    </LinearLayout>

    <LinearLayout
      android:id="@+id/wafra_bill_row_1"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="8dp"
      android:gravity="center_vertical"
      android:orientation="horizontal"
      android:visibility="gone">

      <FrameLayout
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:background="@drawable/wafra_widget_tile"
        android:importantForAccessibility="noHideDescendants">

        <ImageView
          android:id="@+id/wafra_bill_logo_1"
          android:layout_width="22dp"
          android:layout_height="22dp"
          android:layout_gravity="center"
          android:scaleType="fitCenter"
          android:importantForAccessibility="no"
          android:visibility="gone" />

        <ImageView
          android:id="@+id/wafra_bill_logo_mono_1"
          android:layout_width="22dp"
          android:layout_height="22dp"
          android:layout_gravity="center"
          android:scaleType="fitCenter"
          android:tint="@color/wafra_widget_upcoming_text"
          android:importantForAccessibility="no"
          android:visibility="gone" />

        <TextView
          android:id="@+id/wafra_bill_tile_1"
          android:layout_width="match_parent"
          android:layout_height="match_parent"
          android:gravity="center"
          android:maxLines="1"
          android:textColor="@color/wafra_widget_upcoming_text"
          android:textSize="14sp"
          android:textStyle="bold" />

        <ImageView
          android:id="@+id/wafra_bill_glyph_1"
          android:layout_width="16dp"
          android:layout_height="16dp"
          android:layout_gravity="center"
          android:importantForAccessibility="no"
          android:src="@drawable/wafra_widget_glyph_calendar"
          android:visibility="gone" />
      </FrameLayout>

      <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
          android:id="@+id/wafra_bill_title_1"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:fontFamily="sans-serif-medium"
          android:maxLines="1"
          android:ellipsize="end"
          android:textAlignment="viewStart"
          android:textDirection="firstStrongLtr"
          android:textColor="@color/wafra_widget_upcoming_text"
          android:textSize="13sp" />

        <TextView
          android:id="@+id/wafra_bill_date_1"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_gravity="start"
          android:layout_marginTop="2dp"
          android:background="@drawable/wafra_widget_pill"
          android:maxLines="1"
          android:ellipsize="end"
          android:paddingStart="7dp"
          android:paddingEnd="7dp"
          android:textColor="@color/wafra_widget_upcoming_text"
          android:textSize="11sp" />
      </LinearLayout>

      <TextView
        android:id="@+id/wafra_bill_amount_1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:fontFamily="sans-serif-medium"
        android:fontFeatureSettings="tnum"
        android:maxLines="1"
        android:textDirection="firstStrongLtr"
        android:textColor="@color/wafra_widget_upcoming_text"
        android:textSize="13sp" />
    </LinearLayout>

    <LinearLayout
      android:id="@+id/wafra_bill_row_2"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="6dp"
      android:gravity="center_vertical"
      android:orientation="horizontal"
      android:visibility="gone">

      <FrameLayout
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:background="@drawable/wafra_widget_tile"
        android:importantForAccessibility="noHideDescendants">

        <ImageView
          android:id="@+id/wafra_bill_logo_2"
          android:layout_width="22dp"
          android:layout_height="22dp"
          android:layout_gravity="center"
          android:scaleType="fitCenter"
          android:importantForAccessibility="no"
          android:visibility="gone" />

        <ImageView
          android:id="@+id/wafra_bill_logo_mono_2"
          android:layout_width="22dp"
          android:layout_height="22dp"
          android:layout_gravity="center"
          android:scaleType="fitCenter"
          android:tint="@color/wafra_widget_upcoming_text"
          android:importantForAccessibility="no"
          android:visibility="gone" />

        <TextView
          android:id="@+id/wafra_bill_tile_2"
          android:layout_width="match_parent"
          android:layout_height="match_parent"
          android:gravity="center"
          android:maxLines="1"
          android:textColor="@color/wafra_widget_upcoming_text"
          android:textSize="14sp"
          android:textStyle="bold" />

        <ImageView
          android:id="@+id/wafra_bill_glyph_2"
          android:layout_width="16dp"
          android:layout_height="16dp"
          android:layout_gravity="center"
          android:importantForAccessibility="no"
          android:src="@drawable/wafra_widget_glyph_calendar"
          android:visibility="gone" />
      </FrameLayout>

      <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
          android:id="@+id/wafra_bill_title_2"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:fontFamily="sans-serif-medium"
          android:maxLines="1"
          android:ellipsize="end"
          android:textAlignment="viewStart"
          android:textDirection="firstStrongLtr"
          android:textColor="@color/wafra_widget_upcoming_text"
          android:textSize="13sp" />

        <TextView
          android:id="@+id/wafra_bill_date_2"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_gravity="start"
          android:layout_marginTop="2dp"
          android:background="@drawable/wafra_widget_pill"
          android:maxLines="1"
          android:ellipsize="end"
          android:paddingStart="7dp"
          android:paddingEnd="7dp"
          android:textColor="@color/wafra_widget_upcoming_text"
          android:textSize="11sp" />
      </LinearLayout>

      <TextView
        android:id="@+id/wafra_bill_amount_2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:fontFamily="sans-serif-medium"
        android:fontFeatureSettings="tnum"
        android:maxLines="1"
        android:textDirection="firstStrongLtr"
        android:textColor="@color/wafra_widget_upcoming_text"
        android:textSize="13sp" />
    </LinearLayout>

    <LinearLayout
      android:id="@+id/wafra_bill_row_3"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="6dp"
      android:gravity="center_vertical"
      android:orientation="horizontal"
      android:visibility="gone">

      <FrameLayout
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:background="@drawable/wafra_widget_tile"
        android:importantForAccessibility="noHideDescendants">

        <ImageView
          android:id="@+id/wafra_bill_logo_3"
          android:layout_width="22dp"
          android:layout_height="22dp"
          android:layout_gravity="center"
          android:scaleType="fitCenter"
          android:importantForAccessibility="no"
          android:visibility="gone" />

        <ImageView
          android:id="@+id/wafra_bill_logo_mono_3"
          android:layout_width="22dp"
          android:layout_height="22dp"
          android:layout_gravity="center"
          android:scaleType="fitCenter"
          android:tint="@color/wafra_widget_upcoming_text"
          android:importantForAccessibility="no"
          android:visibility="gone" />

        <TextView
          android:id="@+id/wafra_bill_tile_3"
          android:layout_width="match_parent"
          android:layout_height="match_parent"
          android:gravity="center"
          android:maxLines="1"
          android:textColor="@color/wafra_widget_upcoming_text"
          android:textSize="14sp"
          android:textStyle="bold" />

        <ImageView
          android:id="@+id/wafra_bill_glyph_3"
          android:layout_width="16dp"
          android:layout_height="16dp"
          android:layout_gravity="center"
          android:importantForAccessibility="no"
          android:src="@drawable/wafra_widget_glyph_calendar"
          android:visibility="gone" />
      </FrameLayout>

      <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
          android:id="@+id/wafra_bill_title_3"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:fontFamily="sans-serif-medium"
          android:maxLines="1"
          android:ellipsize="end"
          android:textAlignment="viewStart"
          android:textDirection="firstStrongLtr"
          android:textColor="@color/wafra_widget_upcoming_text"
          android:textSize="13sp" />

        <TextView
          android:id="@+id/wafra_bill_date_3"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_gravity="start"
          android:layout_marginTop="2dp"
          android:background="@drawable/wafra_widget_pill"
          android:maxLines="1"
          android:ellipsize="end"
          android:paddingStart="7dp"
          android:paddingEnd="7dp"
          android:textColor="@color/wafra_widget_upcoming_text"
          android:textSize="11sp" />
      </LinearLayout>

      <TextView
        android:id="@+id/wafra_bill_amount_3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:fontFamily="sans-serif-medium"
        android:fontFeatureSettings="tnum"
        android:maxLines="1"
        android:textDirection="firstStrongLtr"
        android:textColor="@color/wafra_widget_upcoming_text"
        android:textSize="13sp" />
    </LinearLayout>
  </LinearLayout>
</FrameLayout>
