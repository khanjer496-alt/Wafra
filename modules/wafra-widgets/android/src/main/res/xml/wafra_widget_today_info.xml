<?xml version="1.0" encoding="utf-8"?>
<!-- updatePeriodMillis is 0: the app pushes each new snapshot, and the widget
     schedules its own re-render at local midnight and when the snapshot expires. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
  android:minWidth="110dp"
  android:minHeight="110dp"
  android:minResizeWidth="110dp"
  android:minResizeHeight="110dp"
  android:targetCellWidth="2"
  android:targetCellHeight="2"
  android:updatePeriodMillis="0"
  android:resizeMode="horizontal|vertical"
  android:widgetCategory="home_screen"
  android:initialLayout="@layout/wafra_widget_today"
  android:previewLayout="@layout/wafra_widget_today_preview"
  android:description="@string/wafra_widget_today_description" />
