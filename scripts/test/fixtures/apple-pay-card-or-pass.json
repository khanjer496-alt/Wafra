{
  "description": "Shared table: native WafraLiveCaptureStore.sanitizedApplePayCardOrPass(input) must equal expected; the JS observation reader must accept every non-null expected value.",
  "cases": [
    {
      "name": "plain",
      "input": "Visa Gold 1234",
      "expected": "Visa Gold 1234"
    },
    {
      "name": "whitespace, bidi override and zero-width are removed",
      "input": "  Visa\n\tGold‮ ​1234  ",
      "expected": "Visa Gold 1234"
    },
    {
      "name": "combining mark kept with its base",
      "input": "école Card",
      "expected": "école Card"
    },
    {
      "name": "leading combining mark kept",
      "input": "́Card",
      "expected": "́Card"
    },
    {
      "name": "ZWJ emoji loses its joiners",
      "input": "Family 👨‍👩‍👧 Card",
      "expected": "Family 👨👩👧 Card"
    },
    {
      "name": "tag-sequence flag loses its tag characters",
      "input": "Flag 🏴󠁧󠁢󠁳󠁣󠁴󠁿",
      "expected": "Flag 🏴"
    },
    {
      "name": "a single grapheme over 80 UTF-16 units is dropped",
      "input": "á́́́́́́́́́́́́́́́́́́́́́́́́́́́́́́́́́́́́́́́́́́́́́́́́́́́́́́́́́́́́́́́́́́́́́́́́́́́́́́́́́́́́́́́́́́́́́́́́́́́",
      "expected": null
    },
    {
      "name": "an over-long trailing grapheme is cut and the space trimmed",
      "input": "Visa á́́́́́́́́́́́́́́́́́́́́́́́́́́́́́́́́́́́́́́́́́́́́́́́́́́́́́́́́́́́́́́́́́́́́́́́́́́́́́́́́́́́́́́́́́́́́́́́́́́́",
      "expected": "Visa"
    },
    {
      "name": "ideographic space collapses",
