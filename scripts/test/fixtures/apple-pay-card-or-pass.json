      "expected": "Card One"
    },
    {
      "name": "line separator collapses",
      "input": "Card Two",
      "expected": "Card Two"
    },
    {
      "name": "no-break space collapses",
      "input": "Card Three",
      "expected": "Card Three"
    },
    {
      "name": "soft hyphen (format character) is removed",
      "input": "Soft­hyphen",
      "expected": "Softhyphen"
    },
    {
      "name": "NEL control becomes a space",
      "input": "AB",
      "expected": "A B"
