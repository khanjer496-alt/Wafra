# Keep EAS uploads aligned with the repository while excluding local-only
# build products that are intentionally not covered by .gitignore.

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native projects are generated by Expo prebuild on EAS.
/ios
/android
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro and logs
.metro-health-check*
npm-debug.*
yarn-debug.*
yarn-error.*

# local state
.DS_Store
*.pem
.env*.local
/.asc/config.json
/.asc/reports/
.coord/
*.tsbuildinfo
app-example/

# Worker-only toolchains and generated outputs
server/node_modules/
server/.wrangler/
server/.test-build/
scripts/test/build/

# Parallel-agent scratch worktrees
.claude/worktrees/

# Local development assistants, editor state, and MCP configuration are not
# application build inputs and must never be uploaded to EAS.
/.agents/
/.argent/
/.claude/
/.codex/
/.cursor/
/.gemini/
/.vscode/
/.mcp.json
/skills-lock.json
/.variate/

# Product and release documentation is not needed by the native build.
/docs/

# Local screenshots, packages, and generated application builds
artifacts/
builds/
/--output
/modules/*/android/build/

# Never include unrelated local launch work or local Cloudflare state in a
# no-VCS internal-device archive. Neither is an app build input.
/.postdelegate-launch-work/
/.wrangler/
/.git/
