# Keep EAS uploads aligned with the repository while excluding local-only
# build products that are intentionally not covered by .gitignore.

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native projects are generated by Expo prebuild on EAS.
/ios
/android
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro and logs
.metro-health-check*
npm-debug.*
yarn-debug.*
yarn-error.*

# local state
.DS_Store
*.pem
.env*.local
.coord/
*.tsbuildinfo
app-example/

# Worker-only toolchains and generated outputs
server/node_modules/
server/.wrangler/
server/.test-build/
scripts/test/build/

# Parallel-agent scratch worktrees
.claude/worktrees/

# Local screenshots, packages, and generated application builds
artifacts/
builds/
