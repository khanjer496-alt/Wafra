{
  "cli": {
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "development-simulator": {
      "extends": "development",
      "ios": {
        "simulator": true
      }
    },
    "preview": {
      "distribution": "internal",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_WAFRA_RELAY_URL": "https://wafra-relay.khanjer496.workers.dev"
      }
    },
    "preview-simulator": {
      "extends": "preview",
      "autoIncrement": false,
      "ios": {
        "simulator": true
      },
      "env": {
        "EXPO_PUBLIC_WAFRA_RELAY_URL": "https://wafra-relay.khanjer496.workers.dev"
      }
    },
    "capture-beta": {
      "distribution": "store",
      "environment": "preview",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_WAFRA_RELAY_URL": "https://wafra-relay.khanjer496.workers.dev",
        "EXPO_PUBLIC_WAFRA_SHORTCUT_URL": "https://github.com/khanjer496-alt/Wafra/releases/download/ios-capture-beta-v2/Wafra-Capture.shortcut",
        "EXPO_PUBLIC_WAFRA_SHORTCUT_FILE_BETA": "1"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_WAFRA_RELAY_URL": "https://wafra-relay.khanjer496.workers.dev",
        "EXPO_PUBLIC_WAFRA_SHORTCUT_URL": "https://www.icloud.com/shortcuts/85bd1e080e5849b591049eccffb9a3a1"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleTeamId": "UV7YN4GQ66",
        "ascAppId": "6799171482"
      }
    }
  }
}
